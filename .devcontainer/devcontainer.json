{
    "name": "Taminaru Codespaces",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        "args": {
            "VARIANT": "ubuntu"
        }
    },
    "remoteUser": "vscode",
    "containerEnv": {
        "MISE_TRUST_ALL": "1",
        "DEBIAN_FRONTEND": "noninteractive",
        "SHELL": "/home/vscode/.local/bin/pwsh",
        "PATH": "/home/vscode/.local/bin:/home/vscode/.local/share/mise/shims:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    },
    "features": {
        "ghcr.io/devcontainers/features/sshd:1": {}
    },
    "forwardPorts": [
        2222
    ],
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.profiles.linux": {
                    "pwsh": {
                        "path": "/home/vscode/.local/bin/pwsh"
                    }
                },
                "terminal.integrated.defaultProfile.linux": "pwsh",
                "terminal.integrated.automationShell.linux": "/bin/bash"
            },
            "extensions": [
                "ms-vscode.powershell",
                "Marlodev.ganbaru"
            ]
        }
    },
    "postCreateCommand": "bash ${containerWorkspaceFolder}/scripts/bootstrap.sh"
}
