{
    "name": "Taminaru Codespaces",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        "args": {
            "VARIANT": "ubuntu"
        }
    },
    "remoteUser": "taminaru",
    "containerEnv": {
        "USER": "taminaru"
    },
    "features": {
        "ghcr.io/devcontainers/features/sshd:1": {}
    },
    "forwardPorts": [
        2222
    ],
    "customizations": {
        "vscode": {
            "settings": {
                "workbench.colorTheme": "Catppuccin Frappé"
            },
            "extensions": [
                "ms-vscode.powershell",
                "Catppuccin.catppuccin-vsc"
            ]
        }
    },
    "postCreateCommand": "rm -f /home/taminaru/.profile /home/taminaru/.bashrc && bash ${containerWorkspaceFolder}/scripts/bootstrap.sh"
}
