# Catppuccin Frappe syntax highlighting (mirrors Set-PSReadLineOption colors in theme.ps1)
set -g fish_color_normal        c6d0f5
set -g fish_color_command       babbf1
set -g fish_color_param         eebebe
set -g fish_color_option        eebebe
set -g fish_color_quote         a6d189
set -g fish_color_operator      f4b8e4
set -g fish_color_comment       838ba7
set -g fish_color_error         e78284
set -g fish_color_escape        ef9f76
set -g fish_color_redirection   e5c890
set -g fish_color_selection     --background=414559
set -g fish_color_search_match  --background=51576d
set -g fish_color_autosuggestion 838ba7
set -g fish_color_cancel        f2d5cf
set -g fish_color_end           e78284
set -g fish_color_keyword       e78284
set -g fish_color_match         babbf1
set -g fish_color_user          c6d0f5
set -g fish_color_host          c6d0f5
set -g fish_color_valid_path    --underline

set -g fish_pager_color_prefix       babbf1 --bold
set -g fish_pager_color_completion   c6d0f5
set -g fish_pager_color_description  838ba7
set -g fish_pager_color_progress     ca9ee6
set -g fish_pager_color_selected_background 51576d
